<odoo>
    <menuitem id="menu_api_root" name="API Keys" parent="crm.crm_menu_config" sequence="20"/>

    <record id="view_api_key_list" model="ir.ui.view">
        <field name="model">api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="key"/>
            </list>
        </field>
    </record>

    <record id="view_api_key_form" model="ir.ui.view">
        <field name="model">api.key</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="key" readonly="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_api_key" model="ir.actions.act_window">
        <field name="name">API Keys</field>
        <field name="res_model">api.key</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_api_keys" parent="menu_api_root" action="action_api_key"/>
</odoo>
